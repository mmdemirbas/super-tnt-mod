{
  "format_version": "1.8.0",
  "//": "TEK 'move' animasyonu — her zaman aciktir (scripts.animate gate YOK).",
  "//2": "Bacak/kol genligi query.ground_speed ile olceklenir: dururken hafif",
  "//3": "(6 derece taban), yururken 45 dereceye kadar. Boylece 'suruklenip donan",
  "//4": "uzuvlar' hatasi imkansiz — hareket bool sorgusu tetiklenmese bile uzuvlar",
  "//5": "canli kalir. Kafa/dokunaclar life_time ile daima kimildar.",
  "animations": {
    "animation.mutant_warden.move": {
      "loop": true,
      "bones": {
        "right_leg": { "rotation": ["math.cos(query.life_time * 130) * math.clamp(query.ground_speed * 120, 15, 45)", 0, 0] },
        "left_leg": { "rotation": ["-math.cos(query.life_time * 130) * math.clamp(query.ground_speed * 120, 15, 45)", 0, 0] },
        "right_arm": { "rotation": ["-math.cos(query.life_time * 130) * math.clamp(query.ground_speed * 100, 18, 40)", 0, 0] },
        "left_arm": { "rotation": ["math.cos(query.life_time * 130) * math.clamp(query.ground_speed * 100, 18, 40)", 0, 0] },
        "body": { "rotation": [0, "math.sin(query.life_time * 60) * 4", "math.sin(query.life_time * 120) * 3"] },
        "head": { "rotation": ["math.sin(query.life_time * 90) * 8", "math.cos(query.life_time * 66) * 8", 0] },
        "left_tendril": { "rotation": ["math.sin(query.life_time * 140) * 18", 0, 0] },
        "right_tendril": { "rotation": ["math.sin(query.life_time * 140 + 40) * 18", 0, 0] }
      }
    }
  }
}
