{
  "format_version": "1.8.0",
  "//": "Ender Send walk/idle. Built-in query, kesin calisir. 3 kafa farkli",
  "//2": "fazlarda salinir (urkutucu enderman havasi).",
  "animations": {
    "animation.ender_send.walk": {
      "loop": true,
      "bones": {
        "right_leg": { "rotation": ["math.cos(query.anim_time * 260) * 28", 0, 0] },
        "left_leg": { "rotation": ["-math.cos(query.anim_time * 260) * 28", 0, 0] },
        "right_arm": { "rotation": ["-math.cos(query.anim_time * 260) * 18", 0, 0] },
        "left_arm": { "rotation": ["math.cos(query.anim_time * 260) * 18", 0, 0] },
        "body": { "rotation": ["math.cos(query.anim_time * 260) * 2", 0, 0] }
      }
    },
    "animation.ender_send.idle": {
      "loop": true,
      "bones": {
        "head_c": { "rotation": ["math.sin(query.life_time * 40) * 5", "math.cos(query.life_time * 28) * 8", 0] },
        "right_head": { "rotation": ["math.sin(query.life_time * 55 + 60) * 6", "math.sin(query.life_time * 33) * 12", 0] },
        "left_head": { "rotation": ["math.sin(query.life_time * 55 + 120) * 6", "math.cos(query.life_time * 37) * 12", 0] },
        "right_arm": { "rotation": [0, 0, "math.sin(query.life_time * 25) * 3"] },
        "left_arm": { "rotation": [0, 0, "-math.sin(query.life_time * 25) * 3"] }
      }
    }
  }
}
