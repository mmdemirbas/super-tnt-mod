{
  "format_version": "1.8.0",
  "//": "TEK 'move' animasyonu — daima acik (gate YOK). Bacak/kol genligi",
  "//2": "query.ground_speed ile olceklenir; dururken hafif, yururken genis.",
  "//3": "3 kafa life_time ile farkli fazlarda salinir (urkutucu enderman havasi).",
  "animations": {
    "animation.ender_send.move": {
      "loop": true,
      "bones": {
        "right_leg": { "rotation": ["math.cos(query.anim_time * 220) * math.clamp(query.ground_speed * 110, 5, 40)", 0, 0] },
        "left_leg": { "rotation": ["-math.cos(query.anim_time * 220) * math.clamp(query.ground_speed * 110, 5, 40)", 0, 0] },
        "right_arm": { "rotation": ["-math.cos(query.anim_time * 220) * math.clamp(query.ground_speed * 90, 6, 30)", 0, "math.sin(query.life_time * 25) * 3"] },
        "left_arm": { "rotation": ["math.cos(query.anim_time * 220) * math.clamp(query.ground_speed * 90, 6, 30)", 0, "-math.sin(query.life_time * 25) * 3"] },
        "body": { "rotation": ["math.cos(query.anim_time * 220) * math.clamp(query.ground_speed * 12, 1, 3)", 0, 0] },
        "head_c": { "rotation": ["math.sin(query.life_time * 40) * 5", "math.cos(query.life_time * 28) * 8", 0] },
        "right_head": { "rotation": ["math.sin(query.life_time * 55 + 60) * 6", "math.sin(query.life_time * 33) * 12", 0] },
        "left_head": { "rotation": ["math.sin(query.life_time * 55 + 120) * 6", "math.cos(query.life_time * 37) * 12", 0] }
      }
    }
  }
}
