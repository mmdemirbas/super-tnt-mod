{
  "format_version": "1.8.0",
  "//": "TEK 'move' animasyonu — daima acik (gate YOK). Bacak/kol genligi",
  "//2": "query.ground_speed ile olceklenir; dururken hafif, yururken genis.",
  "//3": "3 kafa life_time ile farkli fazlarda salinir (urkutucu enderman havasi).",
  "animations": {
    "animation.ender_send.move": {
      "loop": true,
      "bones": {
        "right_leg": { "rotation": ["math.cos(query.life_time * 140) * math.clamp(query.ground_speed * 110, 14, 40)", 0, 0] },
        "left_leg": { "rotation": ["-math.cos(query.life_time * 140) * math.clamp(query.ground_speed * 110, 14, 40)", 0, 0] },
        "right_arm": { "rotation": ["-math.cos(query.life_time * 140) * math.clamp(query.ground_speed * 90, 16, 30)", 0, "math.sin(query.life_time * 80) * 5"] },
        "left_arm": { "rotation": ["math.cos(query.life_time * 140) * math.clamp(query.ground_speed * 90, 16, 30)", 0, "-math.sin(query.life_time * 80) * 5"] },
        "body": { "rotation": ["math.cos(query.life_time * 140) * 3", "math.sin(query.life_time * 55) * 4", 0] },
        "head_c": { "rotation": ["math.sin(query.life_time * 90) * 7", "math.cos(query.life_time * 64) * 10", 0] },
        "right_head": { "rotation": ["math.sin(query.life_time * 110 + 60) * 8", "math.sin(query.life_time * 70) * 14", 0] },
        "left_head": { "rotation": ["math.sin(query.life_time * 110 + 120) * 8", "math.cos(query.life_time * 74) * 14", 0] }
      }
    }
  }
}
